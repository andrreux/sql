-- =========================
-- CONSULTA DE PRUEBA
-- =========================

SELECT 
 c.nombre AS cliente,
 p.nombre AS producto,
 co.cantidad,
 p.precio,
 (co.cantidad * p.precio) AS total
FROM compra co
JOIN cliente c ON co.id_cliente = c.id_cliente
JOIN producto p ON co.id_producto = p.id_producto;
